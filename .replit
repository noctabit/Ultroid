modules = ["bash", "python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["ffmpeg", "freetype", "git", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "mediainfo", "neofetch", "openjpeg", "openssl", "redis", "tcl", "tk", "xcodebuild", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Ultroid Bot"

[[workflows.workflow]]
name = "Ultroid Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m pyUltroid"

[deployment]
deploymentTarget = "vm"
run = ["python3", "-m", "pyUltroid"]
